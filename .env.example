# Discord bot token. Keep the real value out of source control.
DISCORD_TOKEN=replace-with-your-token

# Numeric Discord user ID allowed to bypass configured permissions.
BOT_OWNER_ID=user-id-here

# Discord OAuth credentials for the public dashboard. Add this callback URL
# to your Discord application's OAuth2 redirect list:
# https://observer-dashboard.observer/auth/callback
DISCORD_CLIENT_ID=your-discord-application-id
DISCORD_CLIENT_SECRET=your-discord-oauth-client-secret
PUBLIC_BASE_URL=https://observer-dashboard.observer

# Optional public profile links shown on the landing page.
OBSERVER_CREATOR_NAME=Rocky / Rockus26
OBSERVER_SUPPORT_URL=https://discord.com/channels/1535974879554437210
OBSERVER_SOURCE_URL=https://github.com/blurock2/Observer-cogs
OBSERVER_PORTFOLIO_URL=https://my-website.rockus26.workers.dev/#projects
OBSERVER_KOFI_URL=https://ko-fi.com/supporting_observer
