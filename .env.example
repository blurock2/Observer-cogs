# Discord bot token. Keep the real value out of source control.
DISCORD_TOKEN=replace-with-your-token

# Numeric Discord user ID allowed to bypass configured permissions.
BOT_OWNER_ID=user-id-here

# Discord OAuth credentials for the public dashboard.
# Register https://observer-dashboard.observer/auth/callback as an OAuth2 redirect URL.
DISCORD_CLIENT_ID=your-discord-application-id
DISCORD_CLIENT_SECRET=your-discord-oauth-client-secret
PUBLIC_BASE_URL=https://observer-dashboard.observer

# Optional landing-page profile links.
OBSERVER_CREATOR_NAME=
OBSERVER_SUPPORT_URL=https://discord.com/channels/1535974879554437210
OBSERVER_SOURCE_URL=
